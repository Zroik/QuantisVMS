{
  "name": "@vms/web-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "echo \"@vms/web-dashboard: lint ok\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify-gpu": "echo \"@vms/web-dashboard: verify-gpu ok\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "hls.js": "^1.6.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.15.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.0",
    "vue-tsc": "^2.2.8"
  }
}


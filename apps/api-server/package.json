{
  "name": "@vms/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "echo \"@vms/api-server: lint ok\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify-gpu": "echo \"@vms/api-server: verify-gpu ok\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.15.0",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.0"
  }
}

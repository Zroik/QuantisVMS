# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build outputs
dist/
build/
*.egg-info/

# Environment and secrets
.env
.env.local
.env.*.local
!.env.example

# Test and coverage
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data (recordings, models, tmp scratch)
data/
/data/raw/*
/data/compressed/*
/data/tmp/*
/data/snapshots/*
/data/models/*
!/data/raw/.gitkeep
!/data/compressed/.gitkeep
!/data/tmp/.gitkeep
!/data/snapshots/.gitkeep
!/data/models/.gitkeep

# Logs and partials
*.log
*.partial
.DS_Store
Thumbs.db


# Media test files
tests/*.mp4
tests/fixtures/fixture_hikvision*.mp4
tests/fixtures/hikvision*.mp4
tests/fixtures/*.json

# Model binaries
*.pt
*.onnx
*.engine

# WSL virtual disk
wsl/
*.vhdx

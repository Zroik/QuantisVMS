{
  "name": "@vms/recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify-gpu": "echo \"@vms/recorder: verify-gpu ok\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.15.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.0"
  }
}


# Quantis Environment Configuration Example
# Copy to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# General & Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:8080
# Set to true only when the dashboard is served over HTTPS.
COOKIE_SECURE=false
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
CREDENTIAL_KEY=
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800
UI_DEFAULT_LANG=id

# -----------------------------------------------------------------------------
# Database (MySQL 8.4 LTS)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vms_db
MYSQL_USER=vms_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Cache & Message Broker (Redis 7)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MediaMTX Streaming Server
# -----------------------------------------------------------------------------
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
MEDIAMTX_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Storage Paths (/data volumes)
# Inside Docker containers, this is mapped to /data.
# For local host runs, use relative path ./data or specify your absolute path.
# -----------------------------------------------------------------------------
DATA_DIR=./data
RAW_DIR=./data/raw
COMPRESSED_DIR=./data/compressed
TMP_DIR=./data/tmp
SNAPSHOTS_DIR=./data/snapshots
MODELS_DIR=./data/models

# -----------------------------------------------------------------------------
# Video Retention & Segmentation
# -----------------------------------------------------------------------------
# Production defaults: RAW_RETENTION_SEC=86400, SEGMENT_SEC=3600
# Fast test profile: RAW_RETENTION_SEC=120, SEGMENT_SEC=60
RAW_RETENTION_SEC=120
SEGMENT_SEC=60
RAW_DELETE_GRACE_SEC=3600
DELETE_RAW_AFTER_VERIFY=true

# -----------------------------------------------------------------------------
# Transcode & Smart Probing Pipeline
# -----------------------------------------------------------------------------
# Production defaults: PROBE_INTERVAL_SEC=600, PROBE_SAMPLE_SEC=20
# Fast test profile: PROBE_INTERVAL_SEC=30, PROBE_SAMPLE_SEC=10
PROBE_INTERVAL_SEC=30
PROBE_SAMPLE_SEC=10
CQ_MIN=18
CQ_MAX=48
CQ_SAFETY_MARGIN=0
TRANSCODE_CONCURRENCY=1
STATIC_CQ_TTL_SEC=604800
DEFAULT_TARGET_VMAF_MEAN=85.0
DEFAULT_TARGET_VMAF_P25=81.0
DEFAULT_ENCODER=av1_nvenc
DEFAULT_PRESET=p5

# Derived watchdog timeout: max(60, 6 * PROBE_SAMPLE_SEC)
VMAF_TIMEOUT_SEC=60

# -----------------------------------------------------------------------------
# AI Vision Worker (YOLO26n + TensorRT)
# -----------------------------------------------------------------------------
AI_FPS=10
DEFAULT_CONFIDENCE_THRESHOLD=0.35
EVENT_COOLDOWN_SEC=5
WEIGHT_PERSON=3
WEIGHT_VEHICLE=2
WEIGHT_PET=1
OTHER_CLASS_WEIGHT=1

# -----------------------------------------------------------------------------
# Storage Safety Watermarks
# -----------------------------------------------------------------------------
DISK_HIGH_WATERMARK_PCT=85
DISK_CRITICAL_PCT=95

# -----------------------------------------------------------------------------
# Queue Scheduling Weights (BullMQ Shortest Job First with Aging)
# -----------------------------------------------------------------------------
QUEUE_W_AGE=0.5
QUEUE_W_SIZE=0.2
QUEUE_W_CHEAP=0.3

